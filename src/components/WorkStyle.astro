---
import { workStyle, engagements } from "../data/content";
---

<section id="work-style" class="band">
  <div class="wrap">
    <div class="band-head reveal">
      <p class="eyebrow">How I work</p>
      <h2>What makes a project go well</h2>
      <p>Worth reading before you get in touch — it saves us both a call.</p>
    </div>

    <div class="grid grid--3">
      {workStyle.map((w) => (
        <article class="card reveal">
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </article>
      ))}
    </div>

    <div class="band-head reveal" style="margin-top:3rem">
      <h2 style="font-size:1.4rem">Engagement models</h2>
    </div>
    <div class="grid grid--2">
      {engagements.map((e) => (
        <article class="card reveal">
          <h3 style="font-size:1rem">{e.title}</h3>
          <p>{e.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
