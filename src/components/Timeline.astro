---
import { roles, laneMeta } from "../data/content";

// A video-editor track. Vertical position and height are pure time — a clip
// always sits at its real start month and is exactly as tall as it lasted.
// Roles that ran at the same time cannot share a column, so each one is
// assigned the first free column, the way overlapping events are laid out in
// a calendar. Colour carries the kind of work instead of the column.
const PX_PER_MONTH = 26;
const MIN_H = 96; // a two-month contract still needs room for its title
const COL_GAP = 12;

const monthIndex = (iso: string) => {
  const [y, m] = iso.split("-").map(Number);
  return y * 12 + (m - 1);
};

const now = new Date();
const nowIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const nowIndex = monthIndex(nowIso);
const startIndex = Math.min(...roles.map((r) => monthIndex(r.start)));
const firstYear = Math.ceil(startIndex / 12);
const lastYear = Math.floor(nowIndex / 12);

const fmt = (iso: string | null) =>
  iso === null
    ? "Present"
    : new Date(`${iso}-01T00:00:00Z`).toLocaleDateString("en-GB", {
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      });

// oldest first, so column assignment reads left to right over time
const placed = roles
  .map((r) => {
    const top = (monthIndex(r.start) - startIndex) * PX_PER_MONTH;
    const height = Math.max((monthIndex(r.end ?? nowIso) - monthIndex(r.start)) * PX_PER_MONTH, MIN_H);
    return { ...r, top, height, bottom: top + height };
  })
  .sort((a, b) => a.top - b.top || b.height - a.height);

const columnBottoms: number[] = [];
const clips = placed.map((c) => {
  let col = columnBottoms.findIndex((bottom) => bottom <= c.top);
  if (col === -1) col = columnBottoms.length;
  columnBottoms[col] = c.bottom + COL_GAP;
  return { ...c, col };
});
const cols = columnBottoms.length;

const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i).map((y) => ({
  year: y,
  top: (y * 12 - startIndex) * PX_PER_MONTH,
}));

const trackHeight = Math.max(...clips.map((c) => c.bottom), (nowIndex - startIndex) * PX_PER_MONTH) + 16;
const playheadTop = (nowIndex - startIndex) * PX_PER_MONTH;
const laneColor = { core: "var(--track)", side: "var(--track-side)", research: "var(--track-res)" };
const flat = roles.slice().sort((a, b) => monthIndex(b.start) - monthIndex(a.start));
---

<section id="experience" class="band band--alt">
  <div class="wrap">
    <div class="band-head reveal">
      <p class="eyebrow">Experience</p>
      <h2>Seven years on one track</h2>
      <p>One time axis, top to bottom. Each clip starts at the month the role started and is as tall as the role lasted — roles side by side ran at the same time.</p>
    </div>

    <div class="legend reveal">
      {(Object.keys(laneMeta) as Array<keyof typeof laneMeta>).map((lane) => (
        <span><i style={`background:${laneColor[lane]}`}></i>{laneMeta[lane].label}</span>
      ))}
    </div>

    <!-- wide screens: track view -->
    <div class="timeline" style={`height:${trackHeight}px; --cols:${cols}; --gap:${COL_GAP}px`}>
      <div class="tl-axis" aria-hidden="true">
        {years.map((y) => (
          <>
            <span class="tl-year" style={`top:${y.top}px`}>{y.year}</span>
            <div class="tl-rule" style={`top:${y.top}px`}></div>
          </>
        ))}
        <div class="playhead" style={`top:${playheadTop}px`}><span>now</span></div>
      </div>

      {clips.map((c) => (
        <article
          class="clip"
          style={`--top:${c.top}px; --h:${c.height}px; --col:${c.col}; --clip:${laneColor[c.lane]}`}
        >
          <h3>{c.title}</h3>
          <p class="org">{c.org}</p>
          <p class="when">{fmt(c.start)} — {fmt(c.end)} · {c.place}</p>
          <p class="details">{c.details}</p>
        </article>
      ))}
    </div>

    <!-- narrow screens: plain reverse-chronological list -->
    <div class="tl-stack">
      {flat.map((r) => (
        <article class="clip reveal" style={`--clip:${laneColor[r.lane]}`}>
          <h3>{r.title}</h3>
          <p class="org">{r.org}</p>
          <p class="when">{fmt(r.start)} — {fmt(r.end)} · {r.place}</p>
          <p class="details">{r.details}</p>
        </article>
      ))}
    </div>
  </div>
</section>
